{
  "name": "tailrmade",
  "version": "0.1.0",
  "description": "Build web apps visually in your browser",
  "author": "Jakob & Tobias",
  "license": "AGPL-3.0-or-later",
  "browserslist": "> 0.25%, not dead",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=18.x",
    "yarn": ">=3.x"
  },
  "scripts": {
    "build": "yarn find-missing-awaits && yarn build:self-hosted",
    "build:client": "yarn del-cli dist --force && cross-env NODE_ENV=production BABEL_ENV=production yarn webpack --mode production --env production && yarn verify:client-bundle",
    "build:cloud": "cross-env CLOUD_MODE=true yarn build:client",
    "build:self-hosted": "cross-env CLOUD_MODE=false yarn build:client",
    "code-style-check": "yarn lint-check && yarn prettier:check",
    "dev": "cross-env CLOUD_MODE=false ts-node -P tsconfig.webpack.json node_modules/webpack-dev-server/bin/webpack-dev-server.js --progress --mode development --env development",
    "dev:cloud": "ts-node -P tsconfig.webpack.json node_modules/webpack-dev-server/bin/webpack-dev-server.js --progress --mode development --env development",
    "find-missing-awaits": "yarn eslint ./src --ext .ts,.tsx --config eslint.find-missing-awaits.config.js --quiet",
    "lint-check": "yarn eslint ./src/**/*.ts",
    "prettier": "prettier",
    "prettier:check": "yarn prettier -c ./src/**/*.ts",
    "prettier:format": "yarn prettier --write src/**/*.ts",
    "serve": "node scripts/serve.js",
    "start": "yarn serve",
    "test": "yarn test:jest && yarn test:e2e",
    "test:e2e": "node scripts/run-frontend-tests.js",
    "test:jest": "jest tests/frontend/jest",
    "test-editor": "yarn cypress open --config-file tests/frontend/cypress/cypress.config.ts",
    "test:throttled": "cross-env CYPRESS_cpuThrottleRate=15 CYPRESS_forceSoftwareGL=true yarn test",
    "verify:client-bundle": "node scripts/verify-client-bundle.js",
    "webpack": "ts-node -P tsconfig.webpack.json node_modules/webpack/bin/webpack.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@craftjs/core": "^0.2.12",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.9",
    "@glideapps/glide-data-grid": "^6.0.3",
