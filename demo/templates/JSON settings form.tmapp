            "data": 500,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Empty text",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "No settings to show. Settings JSON needs to be a JSON object with at least one value.",
            "visible": false
          },
          {
            "socketType": "in",
