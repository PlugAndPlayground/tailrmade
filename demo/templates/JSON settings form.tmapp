            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Edit the settings here: the form rebuilds from whatever this holds. Commits on blur, so half-typed JSON never empties the form."
      },
      {
        "id": "ai-node-4",
        "name": "Flatten into form rows",
        "type": "customfunction",
        "x": 0,
        "y": 2134,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(json) => {\n  let data = json;\n  if (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { return []; }\n  }\n  if (data === null || typeof data !== 'object') return [];\n  // number is the Number Field's own copy: it warns on anything that is not a number\n  const rows = [];\n  const isBox = (v) => v !== null && typeof v === 'object';\n  const nameOf = (key, inList) => (inList ? '#' + (Number(key) + 1) : key);\n  const walk = (node, path, trail) => {\n    const inList = Array.isArray(node);\n    const entries = inList ? node.map((v, i) => [i, v]) : Object.entries(node);\n    // fields before sections, or a field after a section would read as part of it\n    entries.filter(([, v]) => !isBox(v)).forEach(([k, v]) => {\n      const p = path.concat([k]);\n      rows.push({ id: JSON.stringify(p), path: p, label: nameOf(k, inList), heading: '', value: v, number: typeof v === 'number' ? v : 0 });\n    });\n    entries.filter(([, v]) => isBox(v)).forEach(([k, v]) => {\n      const p = path.concat([k]);\n      const t = trail.concat([nameOf(k, inList)]);\n      rows.push({ id: JSON.stringify(p), path: p, label: '', heading: t.join(' › '), value: v, number: 0 });\n      walk(v, p, t);\n    });\n  };\n  walk(data, [], []);\n  return rows;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "json",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "One row per value, nested objects and lists become section headings. The path array is the row's id, so edits stay with their setting."
      },
