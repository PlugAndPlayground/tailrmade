            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Places the Settings field template once per row. Key field id keeps each viewer edit on its setting when the JSON changes."
      },
      {
        "id": "ai-node-6",
        "name": "Rebuild the JSON",
        "type": "customfunction",
        "x": 440,
        "y": 4702,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(source, rows, values) => {\n  let data = source;\n  if (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { return {}; }\n  }\n  if (data === null || typeof data !== 'object') return {};\n  // start from the source so key order, empty sections and rows past the cap survive\n  const out = JSON.parse(JSON.stringify(data));\n  (Array.isArray(rows) ? rows : []).forEach((row, i) => {\n    const value = Array.isArray(values) ? values[i] : undefined;\n    if (row.heading || value === undefined) return;\n    let target = out;\n    for (let j = 0; j < row.path.length - 1; j++) target = target[row.path[j]];\n    target[row.path[row.path.length - 1]] = value;\n  });\n  return out;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "source",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "rows",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "values",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Writes each form value back at its row's path. Rows and values line up because the Repeat template keeps the order of its items."
      },
      {
        "id": "ai-node-8",
