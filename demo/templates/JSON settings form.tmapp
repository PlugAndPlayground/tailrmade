      {
        "id": "ai-node-24",
        "name": "Pick the edited value",
        "type": "customfunction",
        "x": 860,
        "y": 3122,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(type, text, number, flag, value) => {\n  // only the widget on show holds this row's answer\n  if (type === 'String') return text;\n  if (type === 'Number') return number;\n  if (type === 'Boolean') return flag;\n  return value;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
