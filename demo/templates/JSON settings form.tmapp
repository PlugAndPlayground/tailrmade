        "socketArray": [
          {
            "socketType": "in",
            "name": "Initial Value",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "{\n  \"appName\": \"Field notes\",\n  \"darkMode\": true,\n  \"maxUploadMb\": 25,\n  \"server\": {\n    \"host\": \"localhost\",\n    \"port\": 8080,\n    \"https\": false\n  },\n  \"notifications\": {\n    \"email\": true,\n    \"digest\": \"weekly\",\n    \"quietHours\": {\n      \"start\": 22,\n      \"end\": 7\n    }\n  },\n  \"tags\": [\n    \"beta\",\n    \"internal\"\n  ]\n}",
            "visible": false
          },
