      {
        "id": "ai-node-34",
        "name": "Pick the edited value",
        "type": "customfunction",
        "x": 860,
        "y": 3338,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(type, text, number, flag, id, value, src) => {\n  // only the widget on show holds this row's answer; the id says where it goes\n  if (type === 'String') return { id, src, leaf: true, value: text };\n  if (type === 'Number') return { id, src, leaf: true, value: number };\n  if (type === 'Boolean') return { id, src, leaf: true, value: flag };\n  return { id, src, leaf: type !== 'JSON' && type !== 'Array', value };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "type",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "text",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "number",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "flag",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "id",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "value",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "src",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Hands the visible widget's value, with its row's path, to Output 1."
      },
