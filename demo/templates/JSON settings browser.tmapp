      {
        "id": "ai-node-4",
        "name": "Parse settings",
        "type": "customfunction",
        "x": 360,
        "y": 1414,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(text) => {\n  // the input adapts to JSON when the text holds JSON, so it can arrive parsed\n  const s = typeof text === 'string' ? text : JSON.stringify(text);\n  // the id tells a new source apart from the one the working copy was made from\n  let hash = 0;\n  for (let i = 0; i < s.length; i++) hash = (hash * 31 + s.charCodeAt(i)) | 0;\n  const id = s.length + ':' + hash;\n  try {\n    const doc = JSON.parse(s);\n    if (doc === null || typeof doc !== 'object') {\n      return { id, doc: null, error: 'Settings JSON needs to be an object or a list.' };\n    }\n    return { id, doc, error: '' };\n  } catch (e) {\n    return { id, doc: null, error: 'Settings JSON is not valid JSON yet.' };\n  }\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "text",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-5",
        "name": "Current level",
        "type": "stateread",
        "x": 0,
        "y": 2134,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "settings-path"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"ArrayType\"}",
            "data": []
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"AnyType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "The open level as a JSON path. The Open and breadcrumb buttons write it with State Write."
      },
      {
        "id": "ai-node-6",
        "name": "Rows for this level",
        "type": "customfunction",
        "x": 380,
        "y": 2134,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(parsed, pathText) => {\n  const doc = parsed && parsed.doc;\n  if (!doc) return [];\n  // a socket turns JSON-looking text into data, so the path can arrive parsed\n  let path = pathText;\n  if (typeof path === 'string') {\n    try { path = JSON.parse(path); } catch (e) {}\n  }\n  if (!Array.isArray(path)) path = [];\n  // a path from earlier data stops at its deepest level that still exists\n  let node = doc;\n  const valid = [];\n  for (const key of path) {\n    if (node === null || typeof node !== 'object' || !(key in node)) break;\n    node = node[key];\n    valid.push(key);\n  }\n  const inList = Array.isArray(node);\n  const entries = inList ? node.map((v, i) => [i, v]) : Object.entries(node);\n  return entries.map(([k, v]) => {\n    const name = inList ? '#' + (k + 1) : k;\n    const box = v !== null && typeof v === 'object';\n    const size = box ? Object.keys(v).length : 0;\n    return {\n      id: JSON.stringify(valid.concat([k])),\n      label: box ? name + ' (' + size + ') ›' : name,\n      // a level only needs its kind here, not its whole subtree\n      value: box ? (Array.isArray(v) ? [] : {}) : v,\n      number: typeof v === 'number' ? v : 0,\n      src: parsed.id,\n    };\n  });\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "parsed",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "pathText",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "One row per value on the open level. Objects and lists come through empty, so a big subtree never travels into the template."
      },
      {
        "id": "ai-node-7",
        "name": "Breadcrumb",
        "type": "customfunction",
        "x": 380,
        "y": 2326,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(parsed, pathText) => {\n  const doc = parsed && parsed.doc;\n  // a socket turns JSON-looking text into data, so the path can arrive parsed\n  let path = pathText;\n  if (typeof path === 'string') {\n    try { path = JSON.parse(path); } catch (e) {}\n  }\n  if (!Array.isArray(path)) path = [];\n  const crumbs = [{ label: 'Settings', target: '[]' }];\n  let node = doc;\n  const valid = [];\n  for (const key of path) {\n    if (node === null || typeof node !== 'object' || !(key in node)) break;\n    const inList = Array.isArray(node);\n    node = node[key];\n    valid.push(key);\n    crumbs.push({ label: inList ? '#' + (key + 1) : String(key), target: JSON.stringify(valid) });\n  }\n  return crumbs.map((c, i) => ({ label: c.label, target: c.target, current: i === crumbs.length - 1 }));\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "parsed",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "pathText",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
