      {
        "id": "ai-node-12",
        "name": "Merge edits",
        "type": "customfunction",
        "x": 440,
        "y": 6078,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(parsed, saved, values) => {\n  if (!parsed || !parsed.doc) return { src: '', edits: {} };\n  // only path -> value: a second copy of a big document overruns the sandbox\n  const edits = saved && saved.src === parsed.id ? Object.assign({}, saved.edits) : {};\n  (Array.isArray(values) ? values : []).forEach((row) => {\n    // rows from the previous source still answer until the form rebuilds\n    if (!row || !row.leaf || row.src !== parsed.id) return;\n    const id = typeof row.id === 'string' ? row.id : JSON.stringify(row.id);\n    let path;\n    try { path = JSON.parse(id); } catch (e) { return; }\n    if (Array.isArray(path) && path.length > 0) edits[id] = row.value;\n  });\n  return { src: parsed.id, edits };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "parsed",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "saved",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "values",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Collects each row's value by its path. Rows carry their path, so a level that is still loading never lands in the wrong place."
      },
      {
        "id": "ai-node-13",
        "name": "Save edits",
        "type": "statewrite",
        "x": 740,
        "y": 6078,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "settings-doc"
          },
          {
            "socketType": "in",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "trigger",
            "name": "Execute",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"change\",\"customFunctionString\":\"\",\"showDetails\":false}}"
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        },
        "comment": "In memory only: after a reload the edited JSON starts from the source again, though each row's edits come back when you open its level."
      },
      {
        "id": "ai-node-14",
        "name": "Show this level",
        "type": "customfunction",
        "x": 740,
        "y": 6270,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(parsed, merged, pathText) => {\n  const doc = parsed && parsed.doc;\n  if (!doc) return ' ';\n  // a socket turns JSON-looking text into data, so the path can arrive parsed\n  let path = pathText;\n  if (typeof path === 'string') {\n    try { path = JSON.parse(path); } catch (e) {}\n  }\n  if (!Array.isArray(path)) path = [];\n  // a path from earlier data stops at its deepest level that still exists\n  let node = doc;\n  const valid = [];\n  for (const key of path) {\n    if (node === null || typeof node !== 'object' || !(key in node)) break;\n    node = node[key];\n    valid.push(key);\n  }\n  const edits = merged && merged.src === parsed.id ? merged.edits : {};\n  const valueAt = (k) => {\n    const id = JSON.stringify(valid.concat([k]));\n    return id in edits ? edits[id] : node[k];\n  };\n  // nested levels stay folded, so a big file never renders as one huge block\n  const fold = (v) => (v !== null && typeof v === 'object'\n    ? (Array.isArray(v) ? '[… ' + v.length + ']' : '{… ' + Object.keys(v).length + '}')\n    : v);\n  const shown = Array.isArray(node)\n    ? node.map((v, i) => fold(valueAt(i)))\n    : Object.fromEntries(Object.keys(node).map((k) => [k, fold(valueAt(k))]));\n  const sourceAt = (path) => path.reduce((n, k) => (n !== null && typeof n === 'object' ? n[k] : undefined), doc);\n  const changed = Object.keys(edits).filter((id) => edits[id] !== sourceAt(JSON.parse(id))).length;\n  const summary = changed ? changed + (changed === 1 ? ' value' : ' values') + ' changed from the source' : 'No changes yet';\n  return summary + '\\n```json\\n' + JSON.stringify(shown, null, 2) + '\\n```';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "parsed",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "merged",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "pathText",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-16",
        "name": "Edited settings",
        "type": "customfunction",
        "x": 740,
        "y": 6486,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(parsed, merged) => {\n  if (!parsed || !parsed.doc) return null;\n  const doc = JSON.parse(JSON.stringify(parsed.doc));\n  const edits = merged && merged.src === parsed.id ? merged.edits : {};\n  Object.keys(edits).forEach((id) => {\n    const path = JSON.parse(id);\n    let target = doc;\n    for (let i = 0; i < path.length - 1; i++) {\n      if (target === null || typeof target !== 'object') return;\n      target = target[path[i]];\n    }\n    if (target !== null && typeof target === 'object') target[path[path.length - 1]] = edits[id];\n  });\n  return doc;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "parsed",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "merged",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The whole edited JSON: the source with every collected value written back. Wire this into whatever should receive the settings."
      },
