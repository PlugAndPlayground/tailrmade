      {
        "id": "ai-node-31",
        "name": "Pick the edited value",
        "type": "customfunction",
        "x": 860,
        "y": 2434,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(type, text, number, flag, value) => {\n  // only the widget on show holds this row's answer\n  if (type === 'String') return text;\n  if (type === 'Number') return number;\n  if (type === 'Boolean') return flag;\n  return value;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "type",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "text",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "number",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "flag",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "value",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Hands the visible widget's value to Output 1."
