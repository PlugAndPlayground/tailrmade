      {
        "id": "ai-node-48",
        "name": "Pick the row's value",
        "type": "customfunction",
        "x": 820,
        "y": 5134,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(group, field, fields) => {\n  // a group answers with its rows, collected in the shape that came in\n  return group ? fields : field;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "group",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "field",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "fields",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "A plain value answers with its Field, a group with its rows."
      },
      {
        "id": "ai-node-49",
        "name": "As number",
        "type": "customfunction",
        "x": 260,
        "y": 5474,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(value) => {\n  // the field is shared by every row, so rows that hold no number give it 0\n  return typeof value === 'number' ? value : 0;\n}",
            "visible": false
