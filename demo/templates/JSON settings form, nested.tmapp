      {
        "id": "ai-node-12",
        "name": "Check for cut lists",
        "type": "customfunction",
        "x": 440,
        "y": 8002,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(source, edited) => {\n  // the source can arrive parsed, since a socket turns JSON-looking text into data\n  let src = source;\n  if (typeof src === 'string') { try { src = JSON.parse(src); } catch (e) { return ' '; } }\n  const cut = [];\n  const walk = (a, b, path) => {\n    if (a === null || typeof a !== 'object' || b === null || typeof b !== 'object') return;\n    const before = Object.keys(a).length, after = Object.keys(b).length;\n    if (after < before) cut.push((path || 'the top level') + ' (' + after + ' of ' + before + ')');\n    Object.keys(b).forEach((k) => walk(a[k], b[k], path ? path + '.' + k : k));\n  };\n  walk(src, edited, '');\n  return cut.length\n    ? 'A form lists at most 500 values per group, so the edited JSON is missing the rest of ' + cut.join(', ') + '.'\n    : ' ';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "source",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "edited",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
